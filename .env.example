# Development Compose configuration. Preserve credentials and paths on restart.
COMPOSE_PROJECT_NAME=razbor

# Persistent host paths must be outside this checkout.
RAZBOR_STORAGE_HOST=${HOME}/.local/share/razbor/jobs
RAZBOR_INDEX_DATA=${HOME}/.local/share/razbor/index
RAZBOR_CBM_BUNDLE=${HOME}/.local/share/razbor/cbm

# Generate a distinct value for each with: openssl rand -hex 32
RAZBOR_DB_BOOTSTRAP_PASSWORD=
RAZBOR_DB_MIGRATION_PASSWORD=
RAZBOR_DB_RUNTIME_PASSWORD=
RAZBOR_INDEX_MANAGEMENT_TOKEN=
RAZBOR_EMBEDDINGS_TOKEN=

# First administrator only. Unset/empty password uses admin/admin and requires
# an immediate password change. Configured passwords need at least 12 characters.
# Restarting never resets an existing account or reopens administrator bootstrap.
# RAZBOR_ADMIN_USERNAME=admin
# RAZBOR_ADMIN_PASSWORD=

# Optional authentication configuration. OIDC groups and role mapping live in TOML.
# RAZBOR_CONFIG_FILE=./config/razbor.local.toml
# RAZBOR_OIDC_CLIENT_SECRET=
# RAZBOR_OIDC_TRANSACTION_SECRET= # Generate with: openssl rand -hex 32

# Optional overrides; omit them to use the Compose defaults shown here.
# RAZBOR_WEB_PORT=3000
# RAZBOR_INDEX_PORT=8790
# RAZBOR_INDEX_OWNER=local-indexer
# RAZBOR_INDEX_CONFIG=./config/indexer.example.toml
# RAZBOR_RUNNER_CONFIG=./config/runner.example.toml

# Optional public HTTPS callback origin for provider webhooks.
# RAZBOR_WEBHOOK_CALLBACK_BASE=https://razbor.example.com

# Optional replacement token issued in Runners after explicit credential rotation.
# First startup provisions from TOML automatically. Remove this after enrollment.
# RAZBOR_RUNNER_ENROLLMENT_TOKEN=

# Optional legacy registry import/file credentials. UI registrations store their
# credentials in PostgreSQL. Preserve these files for existing file-based records.
# RAZBOR_REGISTRY_CONFIG=./config/application.local.toml
# RAZBOR_FORGEJO_TOKEN_FILE=./config/razbor.forgejo.token
# RAZBOR_WEBHOOK_SECRET_FILE=./config/razbor.webhook.secret

# Host-only agent/management CLI variables: docs/getting-started.md#local-commands.
# Compose supplies agent model credentials and service database URLs internally.
